# ─── LLM providers ────────────────────────────────────────────────
# All providers are called via OpenAI-compatible chat-completions endpoints.
# Model IDs and free-tier limits change often: check each provider's docs
# before changing these. Model names live ONLY here, never in code.

# Order in which providers are tried. On 429 / 5xx / timeout the next one is used.
# Providers without an API key are skipped automatically.
LLM_PROVIDER_ORDER=groq,gemini,openrouter

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini (OpenAI-compatible endpoint): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# OpenRouter: https://openrouter.ai/keys
# "openrouter/free" routes to a random currently-free model; any "<id>:free" also works.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-provider request timeout in milliseconds (optional, default 25000)
# LLM_TIMEOUT_MS=25000
